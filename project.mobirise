    "index.html": {
      "settings": {
        "main": true,
        "title": "Curso de Toma de decisiones (GRATIS)",
        "meta_descr": "Curso Online GRATUITO donde aprenderás a tomar decisiones de manera planificada, visualizar el impacto de tus elecciones y adaptarte a las circunstancias con seguridad.",
        "header_custom": "",
        "footer_custom": "",
